# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# JWT secret used for both user and admin tokens
JWT_SECRET=change-me
# Optional: user token lifetime (default 7d)
JWT_EXPIRES_IN=7d

# Optional: only set this if the API is hosted on a different origin.
# Leave empty to use the built-in Next.js API routes at /api.
NEXT_PUBLIC_API_URL=

# Optional: absolute path where uploaded images are stored (default: ./uploads)
UPLOAD_DIR=
